# crates/remote (remote_probe, remote_ssh_config, remote_quote, remote_askpass).
# Probe reports.
"@@pitcrew-probe-begin-0123456789abcdef"
"@@pitcrew-probe-end-0123456789abcdef"
"@@pitcrew-probe-"
"os="
"arch="
"hostname="
"home="
"shell="
"tmux_found=1"
"tmux=tmux "
"sbatch=1"
"squeue=1"
"fs="
"ext2/ext3"
"nfs"
"lustre"
"fuse.sshfs"
"Darwin"
"CYGWIN_NT"
"xonsh"
"\x0d\x0a"
# ssh config.
"Host "
"Host="
"Include "
"Match "
"~/"
"conf.d/*.conf"
"*"
"?"
"!"
"#"
"\x00"
# Shell quoting.
"'"
"\""
"\\"
"'\\''"
"$("
"`"
"${"
"\x0a"
"\x09"
"~"
"="
"-o"
"@-"
"[::1]"
"%eth0"
# askpass prompts.
"confirm\x00"
"none\x00"
"(sam@hpc-login) "
"passphrase"
"password"
"continue connecting"
"authenticity of host"
"accept updated hostkeys?"
"verification code"
"one-time"
"passcode"
"authenticator"
"second factor"
" otp "
" token "
" 2fa "
# SLURM (remote_slurm, remote_site): times, exit codes, #SBATCH options and recipe keys.
"UNLIMITED"
"INFINITE"
"NOT_SET"
"-00:00:00"
"999999999"
"4294967295"
"4294967296"
"18446744073709551615"
"--"
"--constraint="
"--comment="
"--exclusive"
"--nice"
"--signal=B:TERM@60"
"--mail-type=END"
"--dependency=afterok:"
"--job-name="
"--wrap="
"--uid="
"--export="
"hetjob"
"PackJob"
"#SBATCH "
"partition = "
"account = "
"qos = "
"time = "
"cpus = "
"memory = "
"gres = "
"sbatch = ["
"modules = ["
"modules_init = "
"last_hop = \"srun\""
"socket = \"node-local\""
"description = "
"[slurm]"
"\"\"\""
"'''"
"/etc/profile.d/modules.sh"
