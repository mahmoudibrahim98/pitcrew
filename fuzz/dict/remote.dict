# crates/remote (remote_probe, remote_ssh_config, remote_quote, remote_askpass).
# Probe reports.
"@@pitcrew-probe-begin-0123456789abcdef"
"@@pitcrew-probe-end-0123456789abcdef"
"@@pitcrew-probe-"
"os="
"arch="
"hostname="
"home="
"shell="
"tmux_found=1"
"tmux=tmux "
"sbatch=1"
"squeue=1"
"fs="
"ext2/ext3"
"nfs"
"lustre"
"fuse.sshfs"
"Darwin"
"CYGWIN_NT"
"xonsh"
"\x0d\x0a"
# ssh config.
"Host "
"Host="
"Include "
"Match "
"~/"
"conf.d/*.conf"
"*"
"?"
"!"
"#"
"\x00"
# Shell quoting.
"'"
"\""
"\\"
"'\\''"
"$("
"`"
"${"
"\x0a"
"\x09"
"~"
"="
"-o"
"@-"
"[::1]"
"%eth0"
# askpass prompts.
"confirm\x00"
"none\x00"
"(sam@hpc-login) "
"passphrase"
"password"
"continue connecting"
"authenticity of host"
"accept updated hostkeys?"
"verification code"
"one-time"
"passcode"
"authenticator"
"second factor"
" otp "
" token "
" 2fa "
