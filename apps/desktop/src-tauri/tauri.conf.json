{
  "productName": "PitCrew",
  "version": "0.1.0",
  "identifier": "org.pitcrew.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'",
        "worker-src": "'none'",
        "media-src": "'none'",
        "manifest-src": "'none'"
      },
      "freezePrototype": true,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": false,
    "targets": ["deb", "rpm", "appimage", "app", "dmg", "nsis"],
    "publisher": "The PitCrew Authors",
    "copyright": "Copyright The PitCrew Authors",
    "license": "Apache-2.0",
    "category": "DeveloperTool",
    "shortDescription": "Tracks AI coding agents' sessions, locally and on remote machines.",
    "longDescription": "PitCrew tracks AI coding agents' sessions on this computer and on remote and HPC machines, and shows when an agent needs you.",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "linux": {
      "deb": { "recommends": ["openssh-client"] },
      "rpm": {
        "recommends": ["openssh-clients"],
        "compression": { "type": "xz", "level": 6 }
      },
      "appimage": { "bundleMediaFramework": false }
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true,
      "endpoints": ["https://github.com/mahmoudibrahim98/pitcrew/releases/latest/download/latest.json"]
    },
    "deep-link": {
      "desktop": { "schemes": ["pitcrew"] }
    }
  }
}
